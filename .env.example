# Local development uses SQLite automatically. Copy this file to .env.local.
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Explicitly enabled local mode returns the sign-in code to the local UI.
# This mode is disabled by the application in production regardless of this flag.
DEV_EMAIL_MODE=true
ADMIN_EMAILS=curator@example.com

# Production: PostgreSQL, HTTPS APP_URL, random AUTH_SECRET, and real SMTP required.
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Tencent COS / S3-compatible object storage. Serve media over HTTPS.
S3_ENDPOINT=
S3_REGION=ap-guangzhou
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Only for local production smoke tests, never the default deployment:
ALLOW_SQLITE=false
ALLOW_LOCAL_MEDIA=false
